# DEMO-ONLY credentials for the control plane. Committed on purpose so that
# `docker compose up` works with zero setup. NEVER reuse these anywhere real.
# Both tokens must be >= 32 bytes and different from each other.
TOLLGATE_ADMIN_TOKEN=DEMO-ONLY-admin-token-0123456789abcdef-change-me
TOLLGATE_DATAPLANE_TOKEN=DEMO-ONLY-dataplane-token-0123456789abcdef-change-me
TOLLGATE_DATABASE_URL=postgres://tollgate:DEMO-ONLY-pg-password@postgres:5432/tollgate?sslmode=disable
