            "type": "prometheus",
            "uid": "tollgate-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tollgate_request_duration_seconds_bucket{route=~\"$route\"}[1m])))",
          "legendFormat": "p99"
