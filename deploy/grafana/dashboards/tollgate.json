  "templating": {
    "list": [
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tollgate-prometheus"
        },
        "query": {
          "query": "label_values(tollgate_requests_total, route)",
          "refId": "v"
        },
        "definition": "label_values(tollgate_requests_total, route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "upstream",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tollgate-prometheus"
        },
        "query": {
          "query": "label_values(tollgate_backend_up, upstream)",
          "refId": "v"
        },
        "definition": "label_values(tollgate_backend_up, upstream)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
